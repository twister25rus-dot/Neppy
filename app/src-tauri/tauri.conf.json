{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neppy",
  "version": "0.66.5",
  "identifier": "com.neppy.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Neppy",
        "width": 1280,
        "height": 900,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob: https: wss: ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; script-src 'self' 'wasm-unsafe-eval' https://www.googletagmanager.com tauri: tauri://localhost; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https: wss: data: blob: https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self' https: data: blob:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "nsis",
      "msi",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../src/neppy/agent/prompts",
      "recipes/**/*"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libatk-bridge2.0-0",
          "libgbm1",
          "libgdk-pixbuf-2.0-0",
          "libglib2.0-0",
          "libgtk-3-0",
          "libnspr4",
          "libnss3",
          "libwebkit2gtk-4.1-0",
          "libx11-6",
          "libxdo3",
          "libxkbcommon0",
          "libxshmfence1"
        ],
        "desktopTemplate": "main.desktop",
        "postInstallScript": "postinst",
        "postRemoveScript": "postrm"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.3",
      "entitlements": "entitlements.sidecar.plist",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "./images/background-dmg.png"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDQTQwQkI0NjZBOTYxOTEKUldTUllhbG10QXVrakdxbmtqSXRFMUxZQ3VhZE1UREJBNnJkcVJLSXBsWTNNa2k1enBIZmlMRmsK",
      "endpoints": [
        "https://raw.githubusercontent.com/twister25rus-dot/Neppy/main/updater/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "neppy"
        ]
      }
    }
  }
}
